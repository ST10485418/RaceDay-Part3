
@model RaceDay.Mvc.Controllers.ManageEventModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h2>Create New RaceDay Event</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label">
                Event Name
            </label>
            <input asp-for="EventName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Description
            </label>
            <textarea asp-for="Description"
                      class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">
                Event Date
            </label>
            <input asp-for="EventDate"
                   type="datetime-local"
                   class="form-control"
                   value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">
                Location
            </label>
            <input asp-for="Location" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DistanceKm" class="form-label">
                Distance (km)
            </label>
            <input asp-for="DistanceKm"
                   type="number"
                   step="0.01"
                   min="0.01"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EventType" class="form-label">
                Event Type
            </label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive"
                   class="form-check-input" />
            <label asp-for="IsActive"
                   class="form-check-label">
                Active Event
            </label>
        </div>

        <button type="submit" class="btn btn-success">
            Save Event
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
