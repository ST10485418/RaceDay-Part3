@model List<RaceDay.Mvc.Controllers.ManageEventModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <h2>Manage RaceDay Events</h2>
    <p>Create, edit and manage your sporting events.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <a asp-controller="ManageEvents"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Create New Event
    </a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Distance</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@item.Location</td>
                    <td>@item.DistanceKm km</td>
                    <td>@item.EventType</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.EventID"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@item.EventID"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Delete this event?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <p>No active events found.</p>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>
</div>
