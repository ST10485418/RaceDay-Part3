
@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("Role");
    var firstName = Context.Session.GetString("FirstName");
    var accessToken = Context.Session.GetString("AccessToken");

    var isLoggedIn = !string.IsNullOrWhiteSpace(accessToken);
    var isOrganiser = isLoggedIn && role == "Organiser";
    var isParticipant = isLoggedIn && role == "Participant";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDay.Mvc.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- NAVIGATION BAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">

                <!-- RACEDAY BRAND -->
                <a class="navbar-brand fw-bold fs-4"
                   asp-controller="Home"
                   asp-action="Index">
                    RaceDay
                </a>

                <!-- MOBILE MENU BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="raceDayNavbar">

                    <!-- LEFT NAVIGATION -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                        
@if (isOrganiser)
{
    <li class="nav-item">
        <a class="nav-link"
           asp-controller="Organiser"
           asp-action="Index">
            Organiser Dashboard
        </a>
    </li>
}

                        @if (isParticipant)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-white-50">
                                    My Enrolments (Coming Soon)
                                </span>
                            </li>
                        }

                    </ul>

                    <!-- RIGHT NAVIGATION -->
                    <ul class="navbar-nav align-items-lg-center">

                        @if (!isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary fw-semibold"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-lg-3">
                                <span class="navbar-text text-white">
                                    Welcome, @firstName
                                    (@role)
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container mt-4">
        <main role="main" class="pb-5">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">
                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @RenderBody()

        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top bg-white text-muted py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1">
                &copy; @DateTime.Now.Year RaceDay Event Management System
            </p>

            <small>
                Discover Events. Join Races. Track Results.
            </small>
        </div>
    </footer>

    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
