@model List<RaceDay.Mvc.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">

    <h1 class="text-primary fw-bold">
        RaceDay Events
    </h1>

    <p class="text-muted">
        Discover running, walking and cycling
        events across South Africa.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info" role="status">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var raceEvent in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title fw-bold">
                                @raceEvent.EventName
                            </h5>

                            <p class="card-text">
                                @raceEvent.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @raceEvent.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @raceEvent.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @raceEvent.DistanceKm km
                            </p>

                            <span class="badge bg-primary">
                                @raceEvent.EventType
                            </span>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
